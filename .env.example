# Copy to .env. Never commit real values. Everything here is optional: with no LLM key the app runs
# in rule-based mode and says so in the UI and report.
POSTGRES_PASSWORD=change_me

# LLM provider (gemini | openai | none)
LLM_PROVIDER=none
LLM_MODEL=your_configured_model
LLM_API_KEY=your_api_key
# Optional OpenAI-compatible endpoint
LLM_BASE_URL=

# Embeddings (hash = lexical baseline, no key needed; openai | gemini need LLM_API_KEY + EMBEDDING_MODEL)
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=
EMBEDDING_DIM=384

# Retrieval / chunking
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=8
MAX_CONTEXT_CHARS=12000

# Fetching & uploads
FETCH_TIMEOUT_S=15
FETCH_MAX_BYTES=5000000
UPLOAD_MAX_BYTES=10485760
RESPECT_ROBOTS=true
ALLOW_PRIVATE_URLS=false

# Completeness score weights (normalised if they do not sum to 1)
SCORE_W_COVERAGE=0.40
SCORE_W_EVIDENCE=0.25
SCORE_W_RELIABILITY=0.20
SCORE_W_FRESHNESS=0.15

# Optional observability (never blocks the app)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
OTEL_EXPORTER_OTLP_ENDPOINT=

CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
